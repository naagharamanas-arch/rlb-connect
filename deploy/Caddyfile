{
	email {$ACME_EMAIL}
}

# Staging: HTTP Basic Auth in front of everything except the Meta webhook,
# which Meta must reach unauthenticated (it is protected by the app's own
# X-Hub-Signature-256 verification).
{$STAGING_HOST} {
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"

	@webhook path /api/whatsapp/webhook /api/whatsapp/webhook/*
	handle @webhook {
		reverse_proxy app-staging:3000
	}

	handle {
		basic_auth {
			{$STAGING_BASIC_AUTH_USER} {$STAGING_BASIC_AUTH_HASH}
		}
		reverse_proxy app-staging:3000
	}
}
